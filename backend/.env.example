# Copy to .env and fill in real values before running or deploying.
#   cp .env.example .env

PORT=3000

# MongoDB Atlas connection string (or local mongodb://localhost:27017/capstoneDB)
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.mongodb.net/capstoneDB

# Replace with your own long random string:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
