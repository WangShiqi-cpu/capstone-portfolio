# Client env example. Vite exposes only variables starting with VITE_.
# For local dev, the default in src/api.js already points at http://localhost:3000/api.
# For production, set VITE_API_URL on Vercel/Netlify to your deployed backend, e.g.
#   VITE_API_URL=https://your-api.onrender.com/api
VITE_API_URL=http://localhost:3000/api
